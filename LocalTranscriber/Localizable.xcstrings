{
  "sourceLanguage": "ja",
  "strings": {
    "%dパーセント完了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d percent complete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%dパーセント完了"
          }
        }
      }
    },
    "%@、%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、%@"
          }
        }
      }
    },
    "%@でエクスポートしました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported as %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@でエクスポートしました"
          }
        }
      }
    },
    "文字起こし処理中です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription is in progress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし処理中です"
          }
        }
      }
    },
    "文字起こしを開始（⌘↩）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start transcription (⌘↩)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしを開始（⌘↩）"
          }
        }
      }
    },
    "音声ファイルを選択してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an audio file"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルを選択してください"
          }
        }
      }
    },
    "モデルを選択してください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを選択してください"
          }
        }
      }
    },
    "モデルをダウンロードしてください": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the selected model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをダウンロードしてください"
          }
        }
      }
    },
    "処理中です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation in progress"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理中です"
          }
        }
      }
    },
    "文字起こし結果をコピーしました": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription copied"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こし結果をコピーしました"
          }
        }
      }
    },
    "保存しました: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました: %@"
          }
        }
      }
    },
    "Finder で表示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder で表示"
          }
        }
      }
    },
    "アップデートが利用可能です": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが利用可能です"
          }
        }
      }
    },
    "ダウンロード": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード"
          }
        }
      }
    },
    "アップデートを入手": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Update"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを入手"
          }
        }
      }
    },
    "後で": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で"
          }
        }
      }
    },
    "バージョン %@ が利用可能です（現在: %@）。\nダウンロード後、DMG 内の「インストール.command」を実行してください。\n旧バージョンは自動的に置き換えられます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ is available (current: %@).\nAfter downloading, run the installer in the DMG (the file ending in .command).\nThe previous version will be replaced automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@ が利用可能です（現在: %@）。\nダウンロード後、DMG 内の「インストール.command」を実行してください。\n旧バージョンは自動的に置き換えられます。"
          }
        }
      }
    },
    "バージョン %@ が利用可能です（現在: %@）。\nアップデートファイル取得後、DMG 内の「インストール.command」を実行してください。\n旧バージョンは自動的に置き換えられます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ is available (current: %@).\nAfter downloading the update, run the installer in the DMG (the file ending in .command).\nThe previous version will be replaced automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン %@ が利用可能です（現在: %@）。\nアップデートファイル取得後、DMG 内の「インストール.command」を実行してください。\n旧バージョンは自動的に置き換えられます。"
          }
        }
      }
    },
    "モデル": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル"
          }
        }
      }
    },
    "使用するWhisperモデルを選択します": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Whisper model to use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するWhisperモデルを選択します"
          }
        }
      }
    },
    "使用するWhisperモデルを選択します。モデルは別途ダウンロードが必要です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the Whisper model to use. The model must be downloaded separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用するWhisperモデルを選択します。モデルは別途ダウンロードが必要です。"
          }
        }
      }
    },
    "言語": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "音声の言語を選択します": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the language spoken in the audio"
          }

    "モデル未ダウンロード": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Not Downloaded"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル未ダウンロード"
          }
        }
      }
    },
    "未対応のファイル形式です: %@。wav / mp3 / m4a / flac に対応しています。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported file format: %@. Supported formats: wav, mp3, m4a, and flac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未対応のファイル形式です: %@。wav / mp3 / m4a / flac に対応しています。"
          }
        }
      }
    },
    "選択したファイルが見つかりません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected file could not be found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルが見つかりません。"
          }
        }
      }
    },
    "ファイルへのアクセスが拒否されました。もう一度ファイルを選択してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the file was denied. Please select the file again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルへのアクセスが拒否されました。もう一度ファイルを選択してください。"
          }
        }
      }
    },
    "文字起こしをキャンセルしました。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription was canceled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしをキャンセルしました。"
          }
        }
      }
    },
    "エクスポートに失敗しました: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export failed: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートに失敗しました: %@"
          }
        }
      }
    },
    "アプリ設定が不正です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app configuration is invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ設定が不正です。"
          }
        }
      }
    },
    "保存済みファイルへのアクセスを復元できませんでした。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the saved file could not be restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みファイルへのアクセスを復元できませんでした。"
          }
        }
      }
    },
    "モデル「%@」がダウンロードされていません。ツールバーの「ダウンロード」ボタンからダウンロードしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model “%@” has not been downloaded. Download it using the Download button in the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル「%@」がダウンロードされていません。ツールバーの「ダウンロード」ボタンからダウンロードしてください。"
          }
        }
      }
    },
    "モデル「%@」がダウンロードされていません。ツールバーの「モデルをダウンロード」ボタンからダウンロードしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model “%@” has not been downloaded. Download it using the Download Model button in the toolbar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル「%@」がダウンロードされていません。ツールバーの「モデルをダウンロード」ボタンからダウンロードしてください。"
          }
        }
      }
    },
    "モデルがダウンロードされていません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model has not been downloaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがダウンロードされていません。"
          }
        }
      }
    },
    "ファイルサイズが上限（500MB）を超えています。より小さいファイルを選択してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file exceeds the 500 MB limit. Select a smaller file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルサイズが上限（500MB）を超えています。より小さいファイルを選択してください。"
          }
        }
      }
    },
    "処理がキャンセルされました。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation was canceled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理がキャンセルされました。"
          }
        }
      }
    },
    "モデルの読み込みに失敗しました。モデル管理から再ダウンロードしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to load the model. Download it again from model management."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの読み込みに失敗しました。モデル管理から再ダウンロードしてください。"
          }
        }
      }
    },
    "モデルのダウンロードに失敗しました。ネットワーク接続を確認してください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to download the model. Check your network connection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのダウンロードに失敗しました。ネットワーク接続を確認してください。"
          }
        }
      }
    },
    "予期しないエラーが発生しました。もう一度お試しください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予期しないエラーが発生しました。もう一度お試しください。"
          }
        }
      }
    },
    "準備中…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備中…"
          }
        }

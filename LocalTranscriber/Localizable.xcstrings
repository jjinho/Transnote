          "stringUnit": {
            "state": "translated",
            "value": "テキスト、SRT、VTT などの形式で書き出します"
          }
        }
      }
    },
    "選択した音声ファイルの文字起こしを開始します": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start transcribing the selected audio file"
          }
        },

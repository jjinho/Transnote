        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の言語を選択します"
          }
        }
      }
    },
    "音声の言語を選択します。Autoは自動検出です。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the language spoken in the audio. Auto detects it automatically."

        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声の言語を選択します。Autoは自動検出です。"
          }
        }
      }
    },
    "選択中のモデルをダウンロード": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download the selected model"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
